{
  "schema_version": "1.0",
  "teaching": {
    "title": "Bayesian Update with Odds",
    "idea": "Bayesian updating combines prior belief with new evidence by multiplying prior odds by a likelihood ratio.",
    "why": "The same compact mechanism appears in diagnosis, detection, classification, and evidence-based decision making.",
    "mental_model": "Convert probability to odds, scale the odds by how strongly the evidence favors the hypothesis, then convert back to probability."
  },
  "evidence": [
    {
      "id": "e_bayes_odds",
      "claim": "Posterior odds equal prior odds multiplied by the likelihood ratio.",
      "blocks": [
        "b_bayes_odds"
      ]
    }
  ],
  "provenance": {
    "simplifications": [
      "The playground models a binary hypothesis and a single likelihood-ratio update."
    ],
    "toy_examples": [
      "The default prior and likelihood ratio are pedagogical values."
    ]
  },
  "symbols": [
    {
      "symbol": "P(H)",
      "meaning": "Prior probability of the hypothesis",
      "kind": "scalar",
      "units": null
    },
    {
      "symbol": "LR",
      "meaning": "Likelihood ratio contributed by the evidence",
      "kind": "scalar",
      "units": null
    },
    {
      "symbol": "P(H|E)",
      "meaning": "Posterior probability after the evidence",
      "kind": "scalar",
      "units": null
    }
  ],
  "controls": [
    {
      "id": "prior",
      "type": "slider",
      "label": "Prior probability",
      "help": "Initial belief in the hypothesis before observing the new evidence.",
      "value_kind": "scalar",
      "default": 0.3,
      "min": 0.05,
      "max": 0.95,
      "step": 0.05,
      "options": null,
      "shape": null
    },
    {
      "id": "likelihood_ratio",
      "type": "slider",
      "label": "Likelihood ratio",
      "help": "Values above 1 favor the hypothesis; values below 1 favor the alternative.",
      "value_kind": "scalar",
      "default": 3.0,
      "min": 0.1,
      "max": 10.0,
      "step": 0.1,
      "options": null,
      "shape": null
    }
  ],
  "computation": {
    "nodes": [
      {
        "id": "prior_odds",
        "op": "divide",
        "inputs": [
          {
            "ref": "prior"
          },
          {
            "op": "subtract",
            "inputs": [
              {
                "const": 1.0
              },
              {
                "ref": "prior"
              }
            ]
          }
        ],
        "kind": "scalar",
        "shape": null,
        "display": true,
        "label": "Prior odds",
        "format": "0.000",
        "params": {}
      },
      {
        "id": "posterior_odds",
        "op": "multiply",
        "inputs": [
          {
            "ref": "prior_odds"
          },
          {
            "ref": "likelihood_ratio"
          }
        ],
        "kind": "scalar",
        "shape": null,
        "display": true,
        "label": "Posterior odds",
        "format": "0.000",
        "params": {}
      },
      {
        "id": "posterior",
        "op": "divide",
        "inputs": [
          {
            "ref": "posterior_odds"
          },
          {
            "op": "add",
            "inputs": [
              {
                "const": 1.0
              },
              {
                "ref": "posterior_odds"
              }
            ]
          }
        ],
        "kind": "scalar",
        "shape": null,
        "display": true,
        "label": "Posterior probability",
        "format": "0.000",
        "params": {}
      },
      {
        "id": "posterior_complement",
        "op": "subtract",
        "inputs": [
          {
            "const": 1.0
          },
          {
            "ref": "posterior"
          }
        ],
        "kind": "scalar",
        "shape": null,
        "display": false,
        "label": null,
        "format": null,
        "params": {}
      },
      {
        "id": "posterior_distribution",
        "op": "concat",
        "inputs": [
          {
            "ref": "posterior"
          },
          {
            "ref": "posterior_complement"
          }
        ],
        "kind": "vector",
        "shape": [
          2
        ],
        "display": false,
        "label": null,
        "format": "0.000",
        "params": {
          "axis": 0,
          "promote_scalars": true
        }
      }
    ],
    "outputs": [
      "posterior",
      "posterior_distribution"
    ]
  },
  "mechanism_grounding": [
    {
      "nodes": [
        "prior_odds",
        "posterior_odds",
        "posterior"
      ],
      "blocks": [
        "b_bayes_odds"
      ],
      "relationship": "Convert prior probability to odds, multiply by the likelihood ratio, then convert posterior odds back to probability."
    }
  ],
  "visuals": [
    {
      "type": "formula",
      "title": "Bayesian odds update",
      "value": null,
      "bindings": {},
      "options": {
        "display": "posterior odds = prior odds × likelihood ratio"
      }
    },
    {
      "type": "pipeline",
      "title": "Evidence update pipeline",
      "value": null,
      "bindings": {
        "prior": "prior",
        "prior_odds": "prior_odds",
        "posterior_odds": "posterior_odds",
        "posterior": "posterior"
      },
      "options": {}
    },
    {
      "type": "bar_chart",
      "title": "Posterior belief",
      "value": "posterior_distribution",
      "bindings": {},
      "options": {
        "labels": [
          "H",
          "not H"
        ],
        "show_values": true
      }
    },
    {
      "type": "number",
      "title": "Posterior probability",
      "value": "posterior",
      "bindings": {},
      "options": {
        "format": "0.000"
      }
    }
  ],
  "explorations": [
    {
      "title": "Use neutral evidence",
      "change": {
        "instructions": "Set the likelihood ratio to 1.",
        "suggested_values": {
          "likelihood_ratio": 1.0
        }
      },
      "observe": "The posterior returns to the prior probability.",
      "why": "A likelihood ratio of 1 does not favor either hypothesis, so the evidence leaves the odds unchanged.",
      "expectation": {
        "type": "approx",
        "value": "posterior",
        "expected": 0.3,
        "tolerance": 1e-09
      }
    },
    {
      "title": "Use evidence that strongly favors H",
      "change": {
        "instructions": "Increase the likelihood ratio to 9.",
        "suggested_values": {
          "likelihood_ratio": 9.0
        }
      },
      "observe": "The posterior probability moves substantially above the default prior.",
      "why": "Multiplying the prior odds by a large likelihood ratio increases the posterior odds.",
      "expectation": {
        "type": "increases",
        "value": "posterior"
      }
    }
  ],
  "limitation": {
    "kind": "simplification",
    "text": "This playground demonstrates a single binary-hypothesis odds update and does not model uncertainty in the likelihood ratio or multiple dependent evidence items."
  },
  "tests": [
    {
      "name": "neutral evidence leaves the prior unchanged",
      "inputs": {
        "prior": 0.3,
        "likelihood_ratio": 1.0
      },
      "assertions": [
        {
          "value": "posterior",
          "op": "approx",
          "expected": 0.3,
          "tolerance": 1e-09
        }
      ]
    },
    {
      "name": "default example",
      "inputs": {
        "prior": 0.3,
        "likelihood_ratio": 3.0
      },
      "assertions": [
        {
          "value": "posterior",
          "op": "approx",
          "expected": 0.5625,
          "tolerance": 1e-09
        },
        {
          "value": "posterior_distribution",
          "op": "sum_to",
          "expected": 1.0,
          "tolerance": 1e-09
        }
      ]
    }
  ],
  "invariants": [
    {
      "name": "posterior remains a probability",
      "value": "posterior",
      "assertion": {
        "value": "posterior",
        "op": "range",
        "expected": [
          0.0,
          1.0
        ],
        "tolerance": 1e-12
      }
    },
    {
      "name": "binary posterior distribution sums to one",
      "value": "posterior_distribution",
      "assertion": {
        "value": "posterior_distribution",
        "op": "sum_to",
        "expected": 1.0,
        "tolerance": 1e-09
      }
    }
  ]
}
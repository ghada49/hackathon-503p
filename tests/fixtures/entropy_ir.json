{
  "schema_version": "1.0",
  "teaching": {
    "title": "Shannon Entropy",
    "idea": "Entropy measures the average information or uncertainty in a probability distribution.",
    "why": "It distinguishes predictable distributions from distributions whose outcomes are harder to predict.",
    "mental_model": "Each outcome contributes -p log₂(p); entropy adds those contributions."
  },
  "evidence": [
    {
      "id": "e_entropy_definition",
      "claim": "For a discrete distribution, entropy is the sum of -pᵢ log₂(pᵢ), with zero-probability terms contributing zero.",
      "blocks": [
        "b_entropy_definition"
      ]
    }
  ],
  "provenance": {
    "simplifications": [
      "The playground limits the distribution to at most four outcomes for inspection."
    ],
    "toy_examples": [
      "The default four-outcome uniform distribution is a teaching example."
    ]
  },
  "symbols": [
    {
      "symbol": "pᵢ",
      "meaning": "Probability of outcome i",
      "kind": "vector",
      "units": null
    },
    {
      "symbol": "H",
      "meaning": "Entropy",
      "kind": "scalar",
      "units": "bits"
    }
  ],
  "controls": [
    {
      "id": "probabilities",
      "type": "vector_editor",
      "label": "Outcome weights",
      "help": "Enter nonnegative weights. The runtime normalizes the active outcomes into probabilities.",
      "value_kind": "vector",
      "default": [
        0.25,
        0.25,
        0.25,
        0.25
      ],
      "min": 0.0,
      "max": 1.0,
      "step": 0.05,
      "options": null,
      "shape": [
        4
      ]
    },
    {
      "id": "num_outcomes",
      "type": "select",
      "label": "Number of outcomes",
      "help": "Choose how many leading entries are active.",
      "value_kind": "categorical",
      "default": 4,
      "min": null,
      "max": null,
      "step": null,
      "options": [
        2,
        3,
        4
      ],
      "shape": null
    }
  ],
  "computation": {
    "nodes": [
      {
        "id": "active_weights",
        "op": "slice",
        "inputs": [
          {
            "ref": "probabilities"
          }
        ],
        "kind": "vector",
        "shape": null,
        "display": true,
        "label": "Active outcome weights",
        "format": "0.000",
        "params": {
          "start": 0,
          "end_ref": "num_outcomes"
        }
      },
      {
        "id": "p",
        "op": "normalize",
        "inputs": [
          {
            "ref": "active_weights"
          }
        ],
        "kind": "vector",
        "shape": null,
        "display": true,
        "label": "Normalized probabilities",
        "format": "0.000",
        "params": {}
      },
      {
        "id": "zero_mask",
        "op": "equal",
        "inputs": [
          {
            "ref": "p"
          },
          {
            "const": 0.0
          }
        ],
        "kind": "vector",
        "shape": null,
        "display": false,
        "label": null,
        "format": null,
        "params": {}
      },
      {
        "id": "contributions",
        "op": "where",
        "inputs": [
          {
            "ref": "zero_mask"
          },
          {
            "const": 0.0
          },
          {
            "op": "negate",
            "inputs": [
              {
                "op": "multiply",
                "inputs": [
                  {
                    "ref": "p"
                  },
                  {
                    "op": "log2",
                    "inputs": [
                      {
                        "ref": "p"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "kind": "vector",
        "shape": null,
        "display": true,
        "label": "Information contributions -pᵢ log₂(pᵢ)",
        "format": "0.000",
        "params": {}
      },
      {
        "id": "entropy",
        "op": "sum",
        "inputs": [
          {
            "ref": "contributions"
          }
        ],
        "kind": "scalar",
        "shape": null,
        "display": true,
        "label": "Entropy H",
        "format": "0.000",
        "params": {}
      }
    ],
    "outputs": [
      "p",
      "contributions",
      "entropy"
    ]
  },
  "mechanism_grounding": [
    {
      "nodes": [
        "p",
        "contributions",
        "entropy"
      ],
      "blocks": [
        "b_entropy_definition"
      ],
      "relationship": "Normalize the active outcome weights, compute -pᵢ log₂(pᵢ) for each nonzero probability, and sum the contributions."
    }
  ],
  "visuals": [
    {
      "type": "formula",
      "title": "Entropy rule",
      "value": null,
      "bindings": {},
      "options": {
        "display": "H = -Σ pᵢ log₂(pᵢ)"
      }
    },
    {
      "type": "bar_chart",
      "title": "Contribution from each outcome",
      "value": "contributions",
      "bindings": {},
      "options": {
        "show_values": true
      }
    },
    {
      "type": "number",
      "title": "Entropy",
      "value": "entropy",
      "bindings": {},
      "options": {
        "suffix": " bits"
      }
    },
    {
      "type": "pipeline",
      "title": "From probabilities to entropy",
      "value": null,
      "bindings": {
        "probabilities": "p",
        "contributions": "contributions",
        "entropy": "entropy"
      },
      "options": {}
    }
  ],
  "explorations": [
    {
      "title": "Make the outcome certain",
      "change": {
        "instructions": "Set the active distribution to [1, 0, 0, 0].",
        "suggested_values": {
          "probabilities": [
            1.0,
            0.0,
            0.0,
            0.0
          ],
          "num_outcomes": 4
        }
      },
      "observe": "All contribution bars vanish and entropy becomes zero.",
      "why": "A certain outcome carries no uncertainty.",
      "expectation": {
        "type": "approx",
        "value": "entropy",
        "expected": 0.0,
        "tolerance": 1e-09
      }
    },
    {
      "title": "Compare two equally likely outcomes",
      "change": {
        "instructions": "Use two active outcomes while keeping the four default weights equal.",
        "suggested_values": {
          "probabilities": [
            0.25,
            0.25,
            0.25,
            0.25
          ],
          "num_outcomes": 2
        }
      },
      "observe": "The two active probabilities normalize to 0.5 each and the entropy is one bit.",
      "why": "Two equally likely alternatives require one bit of uncertainty.",
      "expectation": {
        "type": "approx",
        "value": "entropy",
        "expected": 1.0,
        "tolerance": 1e-09
      }
    }
  ],
  "limitation": {
    "kind": "simplification",
    "text": "The playground shows small discrete distributions only; it does not cover continuous entropy or reproduce any experimental result."
  },
  "tests": [
    {
      "name": "certainty has zero entropy",
      "inputs": {
        "probabilities": [
          1.0,
          0.0,
          0.0,
          0.0
        ],
        "num_outcomes": 4
      },
      "assertions": [
        {
          "value": "entropy",
          "op": "approx",
          "expected": 0.0,
          "tolerance": 1e-09
        },
        {
          "value": "p",
          "op": "sum_to",
          "expected": 1.0,
          "tolerance": 1e-09
        }
      ]
    },
    {
      "name": "four equally likely outcomes have two bits",
      "inputs": {
        "probabilities": [
          0.25,
          0.25,
          0.25,
          0.25
        ],
        "num_outcomes": 4
      },
      "assertions": [
        {
          "value": "entropy",
          "op": "approx",
          "expected": 2.0,
          "tolerance": 1e-09
        }
      ]
    }
  ],
  "invariants": [
    {
      "name": "probabilities sum to one",
      "value": "p",
      "assertion": {
        "value": "p",
        "op": "sum_to",
        "expected": 1.0,
        "tolerance": 1e-09
      }
    },
    {
      "name": "entropy contributions are nonnegative",
      "value": "contributions",
      "assertion": {
        "value": "contributions",
        "op": "nonnegative",
        "expected": true,
        "tolerance": null
      }
    }
  ]
}
  "explorations": [
    {
      "title": "Make the first query prefer the first key",
      "change": {
        "instructions": "Increase the first component of the first query while leaving the other entries unchanged.",
        "suggested_values": {
          "Q": [
            [
              4.0,
              0.0
            ],
            [
              0.0,
              1.0
            ]
          ]
        }
      },
      "observe": "The first row of the attention heatmap becomes more concentrated on the first key.",
      "why": "The larger first query-key dot product receives a larger softmax weight.",
      "expectation": null
    },
    {
      "title": "Remove score scaling",
      "change": {
        "instructions": "Turn off the 1/√dₖ scaling step.",
        "suggested_values": {
          "use_scaling": false
        }
      },
      "observe": "The relative ordering of scores stays the same, while the softmax concentration changes.",
      "why": "Scaling changes score magnitudes before softmax without changing which score is largest.",
      "expectation": {
        "type": "rows_sum_to",
        "value": "weights",
        "expected": 1.0,
        "tolerance": 1e-06
      }
    }
  ],
  "limitation": {
    "kind": "simplification",
    "text": "This toy example uses tiny matrices and explains the attention calculation only; it does not reproduce the paper's full model or experimental results."
  },
  "tests": [
    {
      "name": "default attention rows are normalized",
      "inputs": {},
      "assertions": [

      ],
      "min": null,
      "max": null,
      "step": null,
      "options": null,
      "shape": [
        2,
        2
      ]
    },
    {
      "id": "use_scaling",
      "type": "checkbox",
      "label": "Use 1/√dₖ scaling",
      "help": "Toggle the scaling step before softmax.",
      "value_kind": "boolean",
      "default": true,
      "min": null,
      "max": null,
      "step": null,
      "options": null,
      "shape": null
    }
  ],
  "computation": {
    "nodes": [
      {
        "id": "scores",
        "op": "matmul",
        "inputs": [
          {
            "ref": "Q"
          },
          {
            "op": "transpose",
            "inputs": [
              {
                "ref": "K"
              }
            ]
          }
        ],
        "kind": "matrix",
        "shape": [
          2,
          2
        ],
        "display": true,
        "label": "Similarity scores QKᵀ",
        "format": "0.000",
        "params": {}
      },
      {
        "id": "scaled_scores",
        "op": "where",
        "inputs": [
          {
            "ref": "use_scaling"
          },
          {
            "op": "divide",
            "inputs": [
              {
                "ref": "scores"
              },
              {
                "op": "sqrt",
                "inputs": [
                  {
                    "const": 2.0
                  }
                ]
              }
            ]
          },
          {
            "ref": "scores"
          }
        ],
        "kind": "matrix",
        "shape": [
          2,
          2
        ],
        "display": true,
        "label": "Scaled scores",
        "format": "0.000",
        "params": {}
      },
      {
        "id": "weights",
        "op": "softmax_rows",
        "inputs": [
          {
            "ref": "scaled_scores"
          }
        ],
        "kind": "matrix",
        "shape": [
          2,
          2
        ],
        "display": true,
        "label": "Attention weights",
        "format": "0.000",
        "params": {}
      },
      {
        "id": "attention_output",
        "op": "matmul",
        "inputs": [
          {
            "ref": "weights"
          },
          {
            "ref": "V"
          }
        ],
        "kind": "matrix",
        "shape": [
          2,
          2
        ],
        "display": true,
        "label": "Weighted output",
        "format": "0.000",
        "params": {}
      }
    ],
    "outputs": [
      "weights",
      "attention_output"
    ]
  },

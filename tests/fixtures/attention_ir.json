{
  "schema_version": "1.0",
  "teaching": {
    "title": "Scaled Dot-Product Attention",
    "idea": "Attention compares each query with keys, converts the similarity scores into weights, and uses those weights to combine the values.",
    "why": "The mechanism lets a model emphasize the values that are most relevant to each query.",
    "mental_model": "Score the matches, normalize the scores into weights, then take a weighted combination of the values."
  },
  "evidence": [
    {
      "id": "e_attention_formula",
      "claim": "Scaled dot-product attention forms query-key dot products, scales them by the square root of the key dimension, applies softmax, and uses the resulting weights to combine values.",
      "blocks": [
        "b_attention_formula"
      ]
    }
  ],
  "provenance": {
    "simplifications": [
      "The playground uses tiny 2×2 matrices so every intermediate value can be inspected directly."
    ],
    "toy_examples": [
      "The default Q, K, and V matrices are pedagogical values and do not reproduce the paper's experiments."
    ]
  },
  "symbols": [
    {
